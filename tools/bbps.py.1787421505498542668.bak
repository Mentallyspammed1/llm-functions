# Static fallback precision rules
from decimal import Decimal, ROUND_DOWN
from types import MappingProxyType
from typing import TypedDict, Final

class _PrecisionRuleDict(TypedDict):
    qty_step: Decimal
    price_step: Decimal
    min_qty: Decimal

FALLBACK_PRECISION_RULES: Final[MappingProxyType[str, _PrecisionRuleDict]] = MappingProxyType({
    "BTCUSDT":  {"qty_step": Decimal("0.001"),  "price_step": Decimal("0.10"),   "min_qty": Decimal("0.001")},
    "ETHUSDT":  {"qty_step": Decimal("0.01"),   "price_step": Decimal("0.01"),   "min_qty": Decimal("0.01")},
    "SOLUSDT":  {"qty_step": Decimal("0.1"),    "price_step": Decimal("0.001"),  "min_qty": Decimal("0.1")},
    "BNBUSDT":  {"qty_step": Decimal("0.01"),   "price_step": Decimal("0.01"),   "min_qty": Decimal("0.01")},
    "ADAUSDT":  {"qty_step": Decimal("1"),      "price_step": Decimal("0.0001"), "min_qty": Decimal("1")},
    "LINKUSDT": {"qty_step": Decimal("0.1"),    "price_step": Decimal("0.001"),  "min_qty": Decimal("0.1")},
    "XRPUSDT":  {"qty_step": Decimal("1"),      "price_step": Decimal("0.0001"), "min_qty": Decimal("1")},
    "DOGEUSDT": {"qty_step": Decimal("1"),      "price_step": Decimal("0.00001"),"min_qty": Decimal("1")},
    "AVAXUSDT": {"qty_step": Decimal("0.1"),    "price_step": Decimal("0.001"),  "min_qty": Decimal("0.1")},
    "NEARUSDT": {"qty_step": Decimal("0.1"),    "price_step": Decimal("0.001"),  "min_qty": Decimal("0.1")},
    "SUIUSDT":  {"qty_step": Decimal("1"),      "price_step": Decimal("0.0001"), "min_qty": Decimal("1")},
})

_DEFAULT_RULE: Final[_PrecisionRuleDict] = {
    "qty_step": Decimal("1"),
    "price_step": Decimal("0.0001"),
    "min_qty": Decimal("1"),
}

def _validate_rules() -> None:
    for symbol, rule in FALLBACK_PRECISION_RULES.items():
        if rule["min_qty"] < rule["qty_step"]:
            raise ValueError(f"Invalid precision rule for {symbol}: min_qty < qty_step")
        if rule["qty_step"] <= 0 or rule["price_step"] <= 0 or rule["min_qty"] <= 0:
            raise ValueError(f"Invalid precision rule for {symbol}: steps must be positive")

_validate_rules()

def get_precision_rules(symbol: str) -> _PrecisionRuleDict:
    """Retrieve precision rules for a symbol, falling back to defaults if unknown."""
    return FALLBACK_PRECISION_RULES.get(symbol.upper(), _DEFAULT_RULE)

def quantize_qty(symbol: str, qty: Decimal) -> Decimal:
    """Quantize quantity down to the symbol's qty_step, respecting min_qty."""
    rules = get_precision_rules(symbol)
    step = rules["qty_step"]
    quantized = (qty // step) * step
    if quantized < rules["min_qty"]:
        return Decimal("0")
    return quantized

def quantize_price(symbol: str, price: Decimal) -> Decimal:
    """Quantize price down to the symbol's price_step."""
    rules = get_precision_rules(symbol)
    step = rules["price_step"]
    return (price // step) * step

def validate_order_params(symbol: str, qty: Decimal, price: Decimal) -> tuple[bool, str]:
    """Validate order quantity and price against symbol rules."""
    rules = get_precision_rules(symbol)
    if qty < rules["min_qty"]:
        return False, f"Quantity {qty} below minimum {rules['min_qty']}"
    if qty % rules["qty_step"] != 0:
        return False, f"Quantity {qty} not aligned with step {rules['qty_step']}"
    if price % rules["price_step"] != 0:
        return False, f"Price {price} not aligned with step {rules['price_step']}"
    return True, "OK"
