class MarketDataEngine:
    @staticmethod
    def get_instrument_info(symbol: str, cache: Optional[ToolCache] = None) -> dict[str, Decimal]:
        cache_key = f"inst_info_{symbol}"
        if cache:
            cached = cache.get(cache_key)
            if cached:
                return {
                    "qty_step": Decimal(str(cached["qty_step"])),
                    "price_step": Decimal(str(cached["price_step"])),
                    "min_qty": Decimal(str(cached["min_qty"])),
                }

        try:
            url = f"https://api.bybit.com/v5/market/instruments-info?category=linear&symbol={symbol}"
            req = urllib.request.Request(url, headers={"User-Agent": f"PyrmScalper/{__version__}"})
            with urllib.request.urlopen(req, timeout=3.5) as resp:
                if resp.status == 200:
                    raw = json.loads(resp.read().decode())
                    if raw.get("retCode") == 0 and "result" in raw:
                        items = raw["result"].get("list", [])
                        if items:
                            info = items[0]
                            lot_filter = info.get("lotSizeFilter", {})
                            price_filter = info.get("priceFilter", {})
                            rules = {
                                "qty_step": Decimal(str(lot_filter.get("qtyStep", "0.01"))),
                                "price_step": Decimal(str(price_filter.get("tickSize", "0.001"))),
                                "min_qty": Decimal(str(lot_filter.get("minOrderQty", "0.01"))),
                            }
                            if cache:
                                cache.set(cache_key, {k: str(v) for k, v in rules.items()})
                            return rules
        except Exception:
            pass

        return FALLBACK_PRECISION_RULES.get(
            symbol, {"qty_step": Decimal("0.01"), "price_step": Decimal("0.001"), "min_qty": Decimal("0.01")}
        )

    @staticmethod
    def get_orderbook(symbol: str, limit: int = 25) -> dict[str, list[list[str]]]:
        with contextlib.suppress(Exception):
            import functions  # type: ignore
            if hasattr(functions, "bybit_realm"):
                res = functions.bybit_realm({"action": "get_orderbook", "symbol": symbol, "limit": limit, "json": True})
                if isinstance(res, dict) and "text" in res:
                    payload = json.loads(res["text"])
                    if "result" in payload and "bids" in payload["result"]:
                        return payload["result"]
        try:
            url = f"https://api.bybit.com/v5/market/orderbook?category=linear&symbol={symbol}&limit={limit}"
            req = urllib.request.Request(url, headers={"User-Agent": f"PyrmScalper/{__version__}"})
            with urllib.request.urlopen(req, timeout=3.5) as resp:
                if resp.status == 200:
                    raw = json.loads(resp.read().decode())
                    if raw.get("retCode") == 0 and "result" in raw:
                        return {"bids": raw["result"].get("b", []), "asks": raw["result"].get("a", [])}
        except Exception:
            pass

        base = {
            "BTCUSDT": 64250.0, "ETHUSDT": 2435.0, "BNBUSDT": 570.0, "SOLUSDT": 142.5,
            "ADAUSDT": 0.35, "LINKUSDT": 11.85, "XRPUSDT": 0.52, "DOGEUSDT": 0.11,
        }
        p = base.get(symbol, 100.0)
        tick = 0.001 if p < 50 else (0.01 if p < 500 else 0.5)
        bids = [[f"{p - (i * tick):.6f}", f"{max(0.01, 12.0 - i * 0.35):.4f}"] for i in range(1, limit + 1)]
        asks = [[f"{p + (i * tick):.6f}", f"{max(0.01, 11.5 - i * 0.35):.4f}"] for i in range(1, limit + 1)]
        return {"bids": bids, "asks": asks}

    @staticmethod
    def get_atr14(symbol: str, interval: str = "1") -> Decimal:
        try:
            url = f"https://api.bybit.com/v5/market/kline?category=linear&symbol={symbol}&interval={interval}&limit=15"
            req = urllib.request.Request(url, headers={"User-Agent": f"PyrmScalper/{__version__}"})
            with urllib.request.urlopen(req, timeout=3.5) as resp:
                if resp.status == 200:
                    raw = json.loads(resp.read().decode())
                    if raw.get("retCode") == 0:
                        klines = raw["result"].get("list", [])
                        if len(klines) >= 14:
                            trs = [Decimal(k[2]) - Decimal(k[3]) for k in klines[:14]]
                            return sum(trs) / Decimal(len(trs))
        except Exception:
            pass
        defaults = {"BTCUSDT": Decimal("150"), "ETHUSDT": Decimal("8.5"), "SOLUSDT": Decimal("0.85")}
        return defaults.get(symbol, Decimal("0.05"))

    @staticmethod
    def get_momentum_1m(symbol: str) -> Decimal:
        try:
            url = f"https://api.bybit.com/v5/market/recent-trade?category=linear&symbol={symbol}&limit=15"
            req = urllib.request.Request(url, headers={"User-Agent": f"PyrmScalper/{__version__}"})
            with urllib.request.urlopen(req, timeout=3.5) as resp:
                if resp.status == 200:
                    raw = json.loads(resp.read().decode())
                    if raw.get("retCode") == 0:
                        trades = raw["result"].get("list", [])
                        if len(trades) >= 2:
                            p0 = Decimal(trades[-1]["price"])
                            p1 = Decimal(trades[0]["price"])
                            return ((p1 - p0) / p0) * Decimal("100")
        except Exception:
            pass
        return Decimal("0")


from __future__ import annotations

from decimal import Decimal, ROUND_DOWN, getcontext
from typing import Optional, List, Dict, Tuple, Any

getcontext().prec = 28

FALLBACK_PRECISION_RULES: Dict[str, Dict[str, Decimal]] = {
    "default": {"qty_step": Decimal("0.01"), "min_qty": Decimal("0.01"), "price_step": Decimal("0.001")},
    "BTCUSDT": {"qty_step": Decimal("0.001"), "min_qty": Decimal("0.001"), "price_step": Decimal("0.1")},
    "ETHUSDT": {"qty_step": Decimal("0.001"), "min_qty": Decimal("0.001"), "price_step": Decimal("0.01")},
}

DEFAULT_TAKER_FEE = Decimal("0.00055")
DEFAULT_MAKER_FEE = Decimal("0.0002")


class MicrostructureAnalyzer:
    @staticmethod
    def quantize(value: Decimal, step: Decimal) -> Decimal:
        if step <= 0:
            return value
        return (value / step).to_integral_value(rounding=ROUND_DOWN) * step

    @staticmethod
    def compute_decay_ofi(bids: List[List[Any]], asks: List[List[Any]], levels: int = 10, decay: Decimal = Decimal("0.85")) -> Decimal:
        bid_w = ask_w = Decimal("0")
        n = min(levels, len(bids), len(asks))
        if n == 0:
            return Decimal("0.5")
        for i in range(n):
            w = decay ** i
            bid_w += Decimal(str(bids[i][1])) * w
            ask_w += Decimal(str(asks[i][1])) * w
        total = bid_w + ask_w
        return (bid_w / total) if total else Decimal("0.5")

    @staticmethod
    def compute_depth_ratio(bids: List[List[Any]], asks: List[List[Any]]) -> Decimal:
        t5b = sum(Decimal(str(b[1])) for b in bids[:5])
        t5a = sum(Decimal(str(a[1])) for a in asks[:5])
        r5 = (t5b / (t5b + t5a)) if (t5b + t5a) else Decimal("0.5")
        t25b = sum(Decimal(str(b[1])) for b in bids[:25])
        t25a = sum(Decimal(str(a[1])) for a in asks[:25])
        r25 = (t25b / (t25b + t25a)) if (t25b + t25a) else Decimal("0.5")
        return (Decimal("0.70") * r5) + (Decimal("0.30") * r25)

    @staticmethod
    def map_dynamic_target(spread: Decimal, override: Optional[Decimal] = None) -> Decimal:
        if override and override > 0:
            return override
        if spread <= Decimal("0.02"):
            return Decimal("0.02")
        if spread <= Decimal("0.05"):
            return Decimal("0.05")
        if spread <= Decimal("0.10"):
            return Decimal("0.10")
        return Decimal("0.20")

    @staticmethod
    def calculate_sizing(
        symbol: str,
        target_profit: Decimal,
        spread: Decimal,
        atr14: Decimal,
        ofi: Decimal,
        composite: Decimal,
        max_loss: Decimal,
        equity: Decimal,
        leverage: Decimal,
        entry: Decimal,
        pos_value_cap: Optional[Decimal] = None,
        pos_pct: Optional[Decimal] = None,
        rules: Optional[Dict[str, Decimal]] = None,
    ) -> Decimal:
        if spread <= 0:
            return Decimal("0")
        base = target_profit / spread
        vol = max(Decimal("0.2"), Decimal("1") - (atr14 / Decimal("100")))
        imb = max(Decimal("0.8"), min(Decimal("1.2"), (Decimal("0.8") + Decimal("0.4") * ofi) * composite))
        qty = base * vol * imb * Decimal("0.99")

        if qty * spread > max_loss:
            qty *= max_loss / (qty * spread)

        max_notional = equity * leverage
        if pos_pct and pos_pct > 0:
            max_notional = min(max_notional, equity * (pos_pct / Decimal("100")) * leverage)
        if pos_value_cap and pos_value_cap > 0:
            max_notional = min(max_notional, pos_value_cap)
        if entry > 0 and qty * entry > max_notional:
            qty = (max_notional / entry) * Decimal("0.98")

        rule = rules or FALLBACK_PRECISION_RULES.get(symbol, FALLBACK_PRECISION_RULES["default"])
        qty = MicrostructureAnalyzer.quantize(qty, rule["qty_step"])
        if qty < rule["min_qty"]:
            qty = rule["min_qty"]
        return qty

    @staticmethod
    def calculate_tp_sl(
        symbol: str,
        entry: Decimal,
        side: str,
        qty: Decimal,
        target: Decimal,
        max_loss: Decimal,
        rules: Optional[Dict[str, Decimal]] = None,
        taker: Decimal = DEFAULT_TAKER_FEE,
        maker: Decimal = DEFAULT_MAKER_FEE,
    ) -> Tuple[Decimal, Decimal, Decimal]:
        entry_fee = entry * qty * taker
        exit_fee = entry * qty * maker
        round_trip = entry_fee + exit_fee
        slip = entry * qty * Decimal("0.0001")
        needed = round_trip + slip + target

        if side.upper() == "BUY":
            tp = entry + (needed / qty)
            sl = entry - (max_loss / qty)
        else:
            tp = entry - (needed / qty)
            sl = entry + (max_loss / qty)

        rule = rules or FALLBACK_PRECISION_RULES.get(symbol, FALLBACK_PRECISION_RULES["default"])
        step = rule["price_step"]
        return (
            MicrostructureAnalyzer.quantize(tp, step),
            MicrostructureAnalyzer.quantize(sl, step),
            target,
        )

    @staticmethod
    def calculate_kelly_fraction(win_rate: Decimal, avg_win: Decimal, avg_loss: Decimal) -> Decimal:
        if avg_loss <= 0:
            return Decimal("0")
        kelly = (win_rate * avg_win - (Decimal("1") - win_rate) * avg_loss) / avg_win
        return max(Decimal("0"), min(Decimal("1"), kelly))

    @staticmethod
    def compute_orderbook_imbalance(bids: List[List[Any]], asks: List[List[Any]], depth: int = 10) -> Decimal:
        n = min(depth, len(bids), len(asks))
        if n == 0:
            return Decimal("0")
        bid_vol = sum(Decimal(str(b[1])) for b in bids[:n])
        ask_vol = sum(Decimal(str(a[1])) for a in asks[:n])
        total = bid_vol + ask_vol
        return (bid_vol - ask_vol) / total if total else Decimal("0")

    @staticmethod
    def estimate_slippage(bids: List[List[Any]], asks: List[List[Any]], side: str, qty: Decimal) -> Decimal:
        book = bids if side.upper() == "SELL" else asks
        remaining = qty
        cost = Decimal("0")
        for level in book:
            price = Decimal(str(level[0]))
            size = Decimal(str(level[1]))
            take = min(remaining, size)
            cost += take * price
            remaining -= take
            if remaining <= 0:
                break
        if remaining > 0:
            return Decimal("Infinity")
        avg_price = cost / qty
        best_price = Decimal(str(book[0][0]))
        return abs(avg_price - best_price) / best_price

    @staticmethod
    def calculate_risk_metrics(
        entry: Decimal,
        tp: Decimal,
        sl: Decimal,
        side: str,
        qty: Decimal,
        equity: Decimal,
    ) -> Dict[str, Decimal]:
        if side.upper() == "BUY":
            risk = entry - sl
            reward = tp - entry
        else:
            risk = sl - entry
            reward = entry - tp
        risk = max(risk, Decimal("0"))
        reward = max(reward, Decimal("0"))
        rr = reward / risk if risk > 0 else Decimal("0")
        risk_pct = (risk * qty) / equity if equity > 0 else Decimal("0")
        return {"risk": risk, "reward": reward, "rr": rr, "risk_pct": risk_pct}


# ==============================================================================
# SECTION 10: Standalone Signed Bybit V5 REST & Order Engine
# ==============================================================================
from __future__ import annotations

import contextlib
import hashlib
import hmac
import json
import os
import time
import urllib.parse
import urllib.request
import uuid
from decimal import Decimal
from typing import Any, Optional

__version__ = "2.1.0"

EXIT_ERROR = 1
EXIT_PERMISSION_DENIED = 13


class ToolError(Exception):
    def __init__(self, message: str, exit_code: int, error_type: str):
        super().__init__(message)
        self.exit_code = exit_code
        self.error_type = error_type


def parse_safe_decimal(value: Any) -> Optional[Decimal]:
    try:
        return Decimal(str(value)) if value is not None else None
    except Exception:
        return None


class OrderExecutionEngine:
    @staticmethod
    def get_credentials() -> tuple[Optional[str], Optional[str]]:
        key = (
            os.environ.get("BYBIT_API_KEY")
            or os.environ.get("BYBIT_KEY")
            or os.environ.get("API_KEY")
        )
        sec = (
            os.environ.get("BYBIT_API_SECRET")
            or os.environ.get("BYBIT_SECRET")
            or os.environ.get("API_SECRET")
        )
        return key, sec

    @staticmethod
    def _send_signed_request(
        method: str,
        path: str,
        params_or_body: dict[str, Any],
        api_key: str,
        api_secret: str,
    ) -> dict[str, Any]:
        """Sign and dispatch generic Bybit V5 REST requests with retry handling."""
        ts = str(int(time.time() * 1000))
        recv = "5000"
        base_url = "https://api.bybit.com"

        if method.upper() == "GET":
            query_str = urllib.parse.urlencode(params_or_body)
            url = f"{base_url}{path}?{query_str}" if query_str else f"{base_url}{path}"
            sign_str = f"{ts}{api_key}{recv}{query_str}"
            req = urllib.request.Request(url, method="GET")
        else:
            payload_str = json.dumps(params_or_body, separators=(",", ":"))
            url = f"{base_url}{path}"
            sign_str = f"{ts}{api_key}{recv}{payload_str}"
            req = urllib.request.Request(url, data=payload_str.encode(), method="POST")
            req.add_header("Content-Type", "application/json")

        sig = hmac.new(api_secret.encode(), sign_str.encode(), hashlib.sha256).hexdigest()
        req.add_header("X-BAPI-API-KEY", api_key)
        req.add_header("X-BAPI-SIGN", sig)
        req.add_header("X-BAPI-TIMESTAMP", ts)
        req.add_header("X-BAPI-RECV-WINDOW", recv)
        req.add_header("User-Agent", f"PyrmScalper/{__version__}")

        last_exc: Optional[Exception] = None
        for attempt in range(1, 4):
            try:
                with urllib.request.urlopen(req, timeout=5.0) as resp:
                    raw = resp.read().decode()
                    data = json.loads(raw)
                    if data.get("retCode") != 0:
                        raise ToolError(
                            f"Bybit API [{data.get('retCode')}]: {data.get('retMsg')}",
                            EXIT_ERROR,
                            "ExchangeAPIError",
                        )
                    return data.get("result", {})
            except ToolError:
                raise
            except Exception as e:
                last_exc = e
                if attempt == 3:
                    break
                time.sleep(0.3 * attempt)

        raise ToolError(
            f"HTTP request to Bybit failed after 3 attempts: {last_exc}",
            EXIT_ERROR,
            "NetworkError",
        )

    @staticmethod
    def get_live_account_state() -> Optional[dict[str, Any]]:
        key, sec = OrderExecutionEngine.get_credentials()
        if not (key and sec):
            return None
        try:
            res_bal = OrderExecutionEngine._send_signed_request(
                "GET", "/v5/account/wallet-balance", {"accountType": "UNIFIED"}, key, sec
            )
            equity = None
            accounts = res_bal.get("list", [])
            if accounts:
                equity = parse_safe_decimal(accounts[0].get("totalEquity"))

            res_pos = OrderExecutionEngine._send_signed_request(
                "GET", "/v5/position/list", {"category": "linear", "settleCoin": "USDT"}, key, sec
            )
            positions = [
                p
                for p in res_pos.get("list", [])
                if Decimal(str(p.get("size", "0"))) > 0
            ]

            return {
                "wallet_equity": equity,
                "open_positions_count": len(positions),
                "open_positions": positions,
            }
        except Exception:
            return None

    @staticmethod
    def execute_trade(
        symbol: str,
        side: str,
        qty: Decimal,
        entry: Decimal,
        tp: Decimal,
        sl: Decimal,
        trailing_stop: Optional[str] = None,
        dry_run: bool = False,
    ) -> dict[str, Any]:
        oid = f"ord_{uuid.uuid4().hex[:12]}"
        if dry_run:
            return {
                "success": True,
                "order_id": oid,
                "symbol": symbol,
                "side": side,
                "qty": float(qty),
                "entry_price": float(entry),
                "tp_price": float(tp),
                "sl_price": float(sl),
                "trailing_stop": trailing_stop,
                "dry_run": True,
                "status": "FILLED_SIMULATED",
            }

        # Try realm function if available
        try:
            import functions  # type: ignore

            if hasattr(functions, "bybit_realm"):
                res = functions.bybit_realm(
                    {
                        "action": "place_smart_order",
                        "symbol": symbol,
                        "side": side,
                        "qty": str(qty),
                        "take_profit": str(tp),
                        "stop_loss": str(sl),
                        "trailing_stop": str(trailing_stop) if trailing_stop else None,
                        "json": True,
                    }
                )
                return {
                    "success": True,
                    "data": res,
                    "order_id": oid,
                    "status": "SUBMITTED_REALM",
                    "dry_run": False,
                }
        except Exception:
            pass  # Fall through to direct API

        key, sec = OrderExecutionEngine.get_credentials()
        if key and sec:
            body: dict[str, Any] = {
                "category": "linear",
                "symbol": symbol,
                "side": side,
                "orderType": "Market",
                "qty": str(qty),
                "timeInForce": "IOC",
                "takeProfit": str(tp),
                "stopLoss": str(sl),
                "tpTriggerBy": "MarkPrice",
                "slTriggerBy": "MarkPrice",
                "tpslMode": "Full",
                "positionIdx": 0,
            }
            if trailing_stop:
                # Accept "100bps" or "100" format
                ts_val = str(trailing_stop).replace("bps", "").strip()
                body["trailingStop"] = ts_val

            res = OrderExecutionEngine._send_signed_request(
                "POST", "/v5/order/create", body, key, sec
            )
            return {
                "success": True,
                "data": res,
                "order_id": res.get("orderId", oid),
                "status": "SUBMITTED_BYBIT_V5",
                "dry_run": False,
            }

        raise ToolError(
            "No live credentials (BYBIT_API_KEY / BYBIT_API_SECRET) and no functions.bybit_realm module. Use --dry-run.",
            EXIT_PERMISSION_DENIED,
            "AuthenticationError",
        )

    @staticmethod
    def cancel_all_orders(symbol: str, dry_run: bool = False) -> dict[str, Any]:
        """Cancel all open orders for a symbol."""
        if dry_run:
            return {"success": True, "symbol": symbol, "cancelled": 0, "dry_run": True}

        key, sec = OrderExecutionEngine.get_credentials()
        if not (key and sec):
            raise ToolError(
                "No live credentials for order cancellation",
                EXIT_PERMISSION_DENIED,
                "AuthenticationError",
            )

        body = {"category": "linear", "symbol": symbol}
        res = OrderExecutionEngine._send_signed_request(
            "POST", "/v5/order/cancel-all", body, key, sec
        )
        return {
            "success": True,
            "data": res,
            "symbol": symbol,
            "cancelled": len(res.get("list", [])),
            "dry_run": False,
        }

    @staticmethod
    def get_open_orders(symbol: Optional[str] = None) -> list[dict[str, Any]]:
        """Fetch open orders, optionally filtered by symbol."""
        key, sec = OrderExecutionEngine.get_credentials()
        if not (key and sec):
            return []

        params: dict[str, Any] = {"category": "linear", "openOnly": 1}
        if symbol:
            params["symbol"] = symbol

        res = OrderExecutionEngine._send_signed_request(
            "GET", "/v5/order/realtime", params, key, sec
        )
        return res.get("list", [])

    @staticmethod
    def amend_order(
        symbol: str,
        order_id: str,
        qty: Optional[Decimal] = None,
        price: Optional[Decimal] = None,
        tp: Optional[Decimal] = None,
        sl: Optional[Decimal] = None,
    ) -> dict[str, Any]:
        """Amend an existing order's qty, price, TP, or SL."""
        key, sec = OrderExecutionEngine.get_credentials()
        if not (key and sec):
            raise ToolError(
                "No live credentials for order amendment",
                EXIT_PERMISSION_DENIED,
                "AuthenticationError",
            )

        body: dict[str, Any] = {
            "category": "linear",
            "symbol": symbol,
            "orderId": order_id,
        }
        if qty is not None:
            body["qty"] = str(qty)
        if price is not None:
            body["price"] = str(price)
        if tp is not None:
            body["takeProfit"] = str(tp)
        if sl is not None:
            body["stopLoss"] = str(sl)

        res = OrderExecutionEngine._send_signed_request(
            "POST", "/v5/order/amend", body, key, sec
        )
        return {"success": True, "data": res, "order_id": order_id}


# ==============================================================================
# SECTION 11: Quantitative Symbol Evaluator
# ==============================================================================
from __future__ import annotations

import decimal
import logging
from decimal import Decimal
from typing import Any, Optional, Tuple

from micro_scalp2 import (
    MarketDataEngine,
    MicrostructureAnalyzer,
    OllamaReasoningEngine,
    OrderExecutionEngine,
    ToolCache,
    ToolError,
)

logger = logging.getLogger(__name__)

decimal.getcontext().prec = 28


def _validate_inputs(
    symbol: str,
    leverage: Decimal,
    max_loss: Decimal,
    equity: Decimal,
    spread_max: Decimal,
) -> Optional[str]:
    if not symbol or not isinstance(symbol, str):
        return "Invalid symbol"
    if leverage <= 0:
        return "Leverage must be positive"
    if max_loss <= 0:
        return "Max loss must be positive"
    if equity <= 0:
        return "Equity must be positive"
    if spread_max < 0:
        return "Spread max cannot be negative"
    return None


def _check_circuit_breaker(symbol: str, cache: Optional[ToolCache]) -> Optional[str]:
    if cache is None:
        return None
    cb_key = f"circuit_breaker:{symbol}"
    if cache.get(cb_key):
        return f"Circuit breaker active for {symbol}"
    return None


def _validate_orderbook_quality(bids: list, asks: list, min_levels: int = 5) -> Optional[str]:
    if len(bids) < min_levels or len(asks) < min_levels:
        return f"Orderbook depth insufficient (< {min_levels} levels)"
    bid_vol = sum(Decimal(str(b[1])) for b in bids[:min_levels])
    ask_vol = sum(Decimal(str(a[1])) for a in asks[:min_levels])
    if bid_vol == 0 or ask_vol == 0:
        return "Zero volume on top levels"
    return None


def _calculate_position_risk(
    qty: Decimal,
    entry: Decimal,
    sl: Decimal,
    equity: Decimal,
    max_pct: Decimal = Decimal("0.02"),
) -> Optional[str]:
    risk_per_share = abs(entry - sl)
    if risk_per_share == 0:
        return "Stop loss equals entry"
    total_risk = qty * risk_per_share
    if total_risk > equity * max_pct:
        return f"Position risk {total_risk:.2f} exceeds {max_pct*100}% of equity"
    return None


def analyze_symbol(
    symbol: str,
    forced_side: Optional[str],
    target: Optional[Decimal],
    leverage: Decimal,
    spread_max: Decimal,
    max_loss: Decimal,
    equity: Decimal,
    pos_value: Optional[Decimal],
    pos_pct: Optional[Decimal],
    trailing_stop: Optional[str],
    enable_ai: bool,
    ollama_host: str,
    ollama_model: str,
    dry_run: bool,
    cache: Optional[ToolCache] = None,
) -> Tuple[Optional[dict[str, Any]], Optional[str]]:
    err = _validate_inputs(symbol, leverage, max_loss, equity, spread_max)
    if err:
        return None, err

    err = _check_circuit_breaker(symbol, cache)
    if err:
        return None, err

    ob = MarketDataEngine.get_orderbook(symbol, 25)
    bids, asks = ob.get("bids", []), ob.get("asks", [])
    if not bids or not asks:
        return None, "Empty orderbook"

    err = _validate_orderbook_quality(bids, asks)
    if err:
        return None, err

    best_bid = Decimal(str(bids[0][0]))
    best_ask = Decimal(str(asks[0][0]))
    spread = best_ask - best_bid
    if spread <= 0:
        return None, "Zero/negative spread"

    mid = (best_bid + best_ask) / 2
    if mid == 0:
        return None, "Mid price zero"

    spread_bps = (spread / mid) * Decimal("10000")
    if spread_bps > spread_max:
        return None, f"Spread {spread_bps:.1f} bps > max {spread_max:.1f}"

    atr = MarketDataEngine.get_atr14(symbol)
    ofi = MicrostructureAnalyzer.compute_decay_ofi(bids, asks)
    depth = MicrostructureAnalyzer.compute_depth_ratio(bids, asks)
    composite = (Decimal("0.60") * ofi) + (Decimal("0.40") * depth)
    mom = MarketDataEngine.get_momentum_1m(symbol)

    long_ok = composite >= Decimal("0.53") and mom >= Decimal("-0.02")
    short_ok = composite <= Decimal("0.47") and mom <= Decimal("0.02")

    if forced_side:
        side = forced_side.capitalize()
        if side == "Buy" and not long_ok:
            return None, f"No Buy edge (Imb {float(composite):.3f}, Mom {float(mom):+.2f}%)"
        if side == "Sell" and not short_ok:
            return None, f"No Sell edge (Imb {float(composite):.3f}, Mom {float(mom):+.2f}%)"
    else:
        if long_ok:
            side = "Buy"
        elif short_ok:
            side = "Sell"
        else:
            return None, f"Neutral (Imb {float(composite):.2f}, Mom {float(mom):+.2f}%)"

    rules = MarketDataEngine.get_instrument_info(symbol, cache=cache)
    dyn_target = MicrostructureAnalyzer.map_dynamic_target(spread, target)
    qty = MicrostructureAnalyzer.calculate_sizing(
        symbol,
        dyn_target,
        spread,
        atr,
        ofi,
        composite,
        max_loss,
        equity,
        leverage,
        mid,
        pos_value,
        pos_pct,
        rules=rules,
    )
    if qty <= 0:
        return None, "Qty zero after sizing"

    total_vol = sum(Decimal(str(b[1])) for b in bids[:25]) + sum(Decimal(str(a[1])) for a in asks[:25])
    if total_vol < (Decimal("5.0") * qty):
        return None, f"Insufficient book depth ({float(total_vol):.2f} < 5x qty {float(5 * qty):.2f})"

    tp, sl, exp_net = MicrostructureAnalyzer.calculate_tp_sl(
        symbol, mid, side, qty, dyn_target, max_loss, rules=rules
    )

    err = _calculate_position_risk(qty, mid, sl, equity)
    if err:
        return None, err

    ai_thesis = None
    if enable_ai:
        try:
            ai_thesis = OllamaReasoningEngine.generate_trade_thesis(
                symbol,
                side,
                ofi,
                mom,
                composite,
                spread_bps,
                host=ollama_host,
                model=ollama_model,
            )
        except Exception as e:
            logger.warning("AI thesis generation failed for %s: %s", symbol, e)

    try:
        res = OrderExecutionEngine.execute_trade(
            symbol,
            side,
            qty,
            mid,
            tp,
            sl,
            trailing_stop=trailing_stop,
            dry_run=dry_run,
        )
    except ToolError as e:
        return None, str(e)

    res.update({
        "spread_bps": float(spread_bps),
        "ofi": float(ofi),
        "momentum": float(mom),
        "composite_imbalance": float(composite),
        "expected_net_pnl": float(exp_net),
        "tp_price": float(tp),
        "sl_price": float(sl),
        "entry_price": float(mid),
        "qty": float(qty),
        "symbol": symbol,
        "side": side,
        "ai_commentary": ai_thesis,
    })
    return res, None


# ==============================================================================
# SECTION 12: Core Execution Engine
# ==============================================================================
def execute_tool(
    symbols: Optional[str] = None,
    symbol: Optional[str] = None,
    side: Optional[str] = None,
    target: Any = "0.02",
    target_profit: Any = None,
    target_profit_usdt: Any = None,
    leverage: Any = 50,
    pos_value: Any = "50.0",
    pos_pct: Any = 0.0,
    spread_max_bps: Any = 15.0,
    max_positions: Any = 1,
    max_workers: Any = 5,
    cooldown: Any = 120,
    loop: Any = False,
    loop_delay: Any = 30,
    risk_reward: Any = "1.0",
    trailing_stop: Any = None,
    max_loss_trade: Any = 0.05,
    daily_loss_cap: Any = 0.50,
    max_drawdown_pct: Any = 15.0,
    state_file: Optional[str] = None,
    trade_log: Optional[str] = None,
    dry_run: Any = False,
    enable_ai: Any = False,
    ollama_host: str = "http://localhost:11434",
    ollama_model: str = "nemotron-3-nano:30b-cloud",
    output_format: str = "jsonl",
    no_color: bool = False,
    verbose: bool = False,
    quiet: bool = False,
    env_vars: Optional[list[str]] = None,
    use_cache: bool = False,
    cache_ttl: int = DEFAULT_CACHE_TTL,
    cache_dir: Optional[str] = None,
    **kwargs: Any,
) -> dict[str, Any]:
    """Universal execution dispatcher with permissive parameter absorption."""
    start = time.monotonic()
    rid = f"scalp_{uuid.uuid4().hex[:10]}"
    setup_tool_logging(verbose, rid)
    warnings: list[str] = []

    parsed_env, env_warns = SecurityValidator.sanitize_env_vars(env_vars)
    warnings.extend(env_warns)
    for k, v in parsed_env.items():
        os.environ[k] = v

    # Resolve parameter aliases
    chosen_symbol = symbol or kwargs.get("symbol")
    chosen_symbols = chosen_symbol or symbols or kwargs.get("symbols") or "BTCUSDT,ETHUSDT,BNBUSDT,ADAUSDT,SOLUSDT"
    chosen_target = target_profit_usdt or target_profit or target or kwargs.get("target_profit") or kwargs.get("target")

    bad = validate_inputs(
        symbols=chosen_symbols, symbol=chosen_symbol, side=side, target=chosen_target,
        leverage=leverage, spread_max_bps=spread_max_bps,
        max_loss_trade=max_loss_trade, daily_loss_cap=daily_loss_cap,
        output_format=output_format
    )
    if bad:
        return bad

    target_d = parse_safe_decimal(chosen_target, Decimal("0.02"))
    lev_d = parse_safe_decimal(leverage, Decimal("50"))
    pos_val_d = parse_safe_decimal(pos_value)
    pos_pct_d = parse_safe_decimal(pos_pct, Decimal("0"))
    spread_d = parse_safe_decimal(spread_max_bps, Decimal("15"))
    max_loss_d = parse_safe_decimal(max_loss_trade, Decimal("0.05"))
    daily_cap_d = parse_safe_decimal(daily_loss_cap, Decimal("0.50"))
    max_dd_d = parse_safe_decimal(max_drawdown_pct, Decimal("15"))
    cooldown_sec = int(parse_safe_float(cooldown, 120) or 120)
    max_pos = int(parse_safe_float(max_positions, 1) or 1)
    max_work = int(parse_safe_float(max_workers, 5) or 5)
    dry = parse_safe_bool(dry_run, False)
    ai_enabled = parse_safe_bool(enable_ai, False)
    forced_side = _clean_str(side).capitalize() if side else None

    tool_cache = ToolCache(cache_dir=cache_dir, ttl=cache_ttl) if use_cache else None
    state_mgr = ScalperStateManager(state_file, trade_log)
    state = state_mgr.load()

    # Synchronize live exchange state
    if not dry:
        live_state = OrderExecutionEngine.get_live_account_state()
        if live_state:
            if live_state.get("wallet_equity"):
                state["wallet_equity"] = str(live_state["wallet_equity"])
            if live_state.get("open_positions_count", 0) >= max_pos:
                msg = f"Max simultaneous open positions reached on Bybit ({live_state['open_positions_count']} >= {max_pos})"
                return {
                    "success": True, "status": "MAX_POSITIONS_REACHED", "message": msg,
                    "state": state, "orders": [], "duration_ms": round((time.monotonic() - start) * 1000, 2)
                }

    wallet = parse_safe_decimal(state.get("wallet_equity"), Decimal("2.00"))
    daily = parse_safe_decimal(state.get("daily_pnl"), Decimal("0"))
    peak = parse_safe_decimal(state.get("equity_peak"), Decimal("0"))
    if peak is None or wallet > peak:
        peak = wallet
        state["equity_peak"] = str(peak)

    if daily <= -daily_cap_d:
        msg = f"Daily loss cap hit (-${abs(daily):.4f} <= -${daily_cap_d:.4f}). Halted."
        return {
            "success": False, "error": msg, "type": "DailyLossCapExceeded",
            "state": state, "duration_ms": round((time.monotonic() - start) * 1000, 2)
        }

    if peak > 0:
        dd = ((peak - wallet) / peak) * 100
        if dd > max_dd_d:
            msg = f"Drawdown {dd:.1f}% > {max_dd_d:.1f}%. Halted."
            return {
                "success": False, "error": msg, "type": "MaxDrawdownExceeded",
                "state": state, "duration_ms": round((time.monotonic() - start) * 1000, 2)
            }

    pause = state.get("pause_until")
    if pause:
        try:
            if datetime.datetime.utcnow() < datetime.datetime.fromisoformat(pause):
                return {
                    "success": True, "status": "COOLDOWN_ACTIVE", "message": f"Paused until {pause}",
                    "state": state, "orders": [], "duration_ms": round((time.monotonic() - start) * 1000, 2)
                }
            state["pause_until"] = None
            state["consecutive_losses"] = 0
        except Exception:
            state["pause_until"] = None

    target_syms = [_clean_str(s).upper() for s in _clean_str(chosen_symbols).split(",") if _clean_str(s)]
    placed: list[dict] = []
    skipped: dict[str, str] = {}

    now_epoch = time.time()
    sym_cooldowns = state.get("symbol_cooldowns", {})
    eligible_syms = []
    for sym in target_syms:
        last_exec = sym_cooldowns.get(sym, 0)
        if (now_epoch - last_exec) < cooldown_sec:
            skipped[sym] = f"Per-symbol cooldown active ({int(cooldown_sec - (now_epoch - last_exec))}s remaining)"
        else:
            eligible_syms.append(sym)

    if eligible_syms:
        with concurrent.futures.ThreadPoolExecutor(max_workers=max_work) as pool:
            futs = {
                pool.submit(
                    analyze_symbol,
                    sym,
                    forced_side if len(target_syms) == 1 else None,
                    target_d,
                    lev_d,
                    spread_d,
                    max_loss_d,
                    wallet,
                    pos_val_d,
                    pos_pct_d,
                    trailing_stop,
                    ai_enabled,
                    ollama_host,
                    ollama_model,
                    dry,
                    tool_cache,
                ): sym
                for sym in eligible_syms
            }
            for fut in concurrent.futures.as_completed(futs):
                sym = futs[fut]
                try:
                    res, reason = fut.result()
                    if res:
                        placed.append(res)
                        sym_cooldowns[sym] = now_epoch
                        if len(placed) >= max_pos:
                            break
                    elif reason:
                        skipped[sym] = reason
                except Exception as e:
                    skipped[sym] = f"Scan error: {e}"

    state["symbol_cooldowns"] = sym_cooldowns

    if placed:
        for o in placed:
            exp = Decimal(str(o.get("expected_net_pnl", 0.02)))
            if dry:
                daily += exp
                wallet += exp
                if wallet > peak:
                    peak = wallet
                state["daily_pnl"] = str(daily)
                state["wallet_equity"] = str(wallet)
                state["equity_peak"] = str(peak)
            state["consecutive_losses"] = 0
            state_mgr.log_trade({
                "timestamp": datetime.datetime.utcnow().isoformat() + "Z",
                "request_id": rid,
                **o,
            })
        state_mgr.save(state)

    duration = round((time.monotonic() - start) * 1000, 2)
    return {
        "success": True,
        "request_id": rid,
        "timestamp": datetime.datetime.utcnow().isoformat() + "Z",
        "target": str(target_d),
        "leverage": int(lev_d),
        "orders_placed": len(placed),
        "orders": placed,
        "skipped": skipped,
        "state": {
            "wallet_equity": float(wallet),
            "daily_pnl": float(daily),
            "equity_peak": float(peak),
            "consecutive_losses": state.get("consecutive_losses", 0),
        },
        "dry_run": dry,
        "duration_ms": duration,
        "warnings": warnings,
        "exit_code": EXIT_SUCCESS,
    }


# ==============================================================================
# SECTION 13: Output Routing & Main CLI Entrypoint
# ==============================================================================


import os
import sys
import json
import tempfile
import shutil
from pathlib import Path
from typing import Any, Optional, Literal
from datetime import datetime
from contextlib import contextmanager


class ToolJSONEncoder(json.JSONEncoder):
    """Extended JSON encoder handling common non-serializable types."""
    def default(self, obj: Any) -> Any:
        if hasattr(obj, "__json__"):
            return obj.__json__()
        if hasattr(obj, "isoformat"):
            return obj.isoformat()
        if hasattr(obj, "__dict__"):
            return obj.__dict__
        try:
            return super().default(obj)
        except TypeError:
            return str(obj)


@contextmanager
def _atomic_write(path: Path, mode: str = "w", encoding: str = "utf-8"):
    """Context manager for atomic file writes via temp file + rename."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode=mode, encoding=encoding, dir=path.parent, delete=False, prefix=f".{path.name}.tmp."
    ) as tmp:
        try:
            yield tmp
            tmp.flush()
            os.fsync(tmp.fileno())
        except Exception:
            try:
                os.unlink(tmp.name)
            except OSError:
                pass
            raise
        else:
            os.replace(tmp.name, path)


def _rotate_if_needed(path: Path, max_bytes: int = 10_000_000, max_files: int = 5) -> None:
    """Rotate log file if it exceeds max_bytes, keeping max_files backups."""
    if not path.exists() or path.stat().st_size < max_bytes:
        return
    for i in range(max_files - 1, 0, -1):
        src = path.with_suffix(f".{i}{path.suffix}")
        dst = path.with_suffix(f".{i + 1}{path.suffix}")
        if src.exists():
            if dst.exists():
                dst.unlink()
            src.rename(dst)
    if path.exists():
        path.rename(path.with_suffix(f".1{path.suffix}"))


def write_llm_output(
    data: dict[str, Any],
    output_format: Literal["json", "jsonl", "yaml", "msgpack"] = "jsonl",
    *,
    max_bytes: int = 10_000_000,
    max_files: int = 5,
    atomic: bool = True,
) -> None:
    """
    Write structured data to LLM_OUTPUT destination with rotation and atomic writes.

    Args:
        data: Dictionary to serialize.
        output_format: Serialization format.
        max_bytes: Max file size before rotation (default 10MB).
        max_files: Number of rotated files to keep (default 5).
        atomic: Use atomic write (temp file + rename) for durability.
    """
    path_str = os.environ.get("LLM_OUTPUT", "/dev/stdout")
    stdout_targets = {"/dev/stdout", "/dev/fd/1", "-", "stdout", "fd://1"}

    if output_format == "json":
        payload = json.dumps(data, ensure_ascii=False, cls=ToolJSONEncoder, indent=2)
    elif output_format == "jsonl":
        payload = json.dumps(data, ensure_ascii=False, cls=ToolJSONEncoder, separators=(",", ":"))
    elif output_format == "yaml":
        try:
            import yaml
        except ImportError:
            sys.stderr.write("PyYAML not installed; falling back to JSONL\n")
            payload = json.dumps(data, ensure_ascii=False, cls=ToolJSONEncoder, separators=(",", ":"))
        else:
            payload = yaml.safe_dump(data, allow_unicode=True, sort_keys=False).rstrip()
    elif output_format == "msgpack":
        try:
            import msgpack
        except ImportError:
            sys.stderr.write("msgpack not installed; falling back to JSONL\n")
            payload = json.dumps(data, ensure_ascii=False, cls=ToolJSONEncoder, separators=(",", ":"))
        else:
            payload = msgpack.packb(data, use_bin_type=True).decode("latin-1")
    else:
        raise ValueError(f"Unsupported output_format: {output_format}")

    if path_str in stdout_targets:
        sys.stdout.write(payload + "\n")
        sys.stdout.flush()
        return

    path = Path(path_str).expanduser().resolve()

    try:
        if atomic and path_str not in stdout_targets:
            _rotate_if_needed(path, max_bytes, max_files)
            with _atomic_write(path, mode="a", encoding="utf-8") as fp:
                fp.write(payload + "\n")
        else:
            _rotate_if_needed(path, max_bytes, max_files)
            path.parent.mkdir(parents=True, exist_ok=True)
            with open(path, "a", encoding="utf-8") as fp:
                fp.write(payload + "\n")
    except OSError as e:
        sys.stderr.write(f"[{datetime.utcnow().isoformat()}Z] Failed writing LLM_OUTPUT ({path}): {e}\n")
        sys.stdout.write(payload + "\n")
        sys.stdout.flush()


def configure_llm_output(
    path: Optional[str] = None,
    format: Literal["json", "jsonl", "yaml", "msgpack"] = "jsonl",
    max_bytes: int = 10_000_000,
    max_files: int = 5,
) -> None:
    """Convenience function to configure LLM_OUTPUT via environment for subprocesses."""
    if path is not None:
        os.environ["LLM_OUTPUT"] = path
    os.environ["LLM_OUTPUT_FORMAT"] = format
    os.environ["LLM_OUTPUT_MAX_BYTES"] = str(max_bytes)
    os.environ["LLM_OUTPUT_MAX_FILES"] = str(max_files)


def read_llm_output(path: Optional[str] = None, format: Optional[str] = None) -> list[dict[str, Any]]:
    """Read and parse all records from an LLM_OUTPUT file (handles rotation)."""
    path_str = path or os.environ.get("LLM_OUTPUT", "/dev/stdout")
    if path_str in {"/dev/stdout", "/dev/fd/1", "-", "stdout", "fd://1"}:
        raise ValueError("Cannot read from stdout target")
    p = Path(path_str).expanduser().resolve()
    fmt = format or os.environ.get("LLM_OUTPUT_FORMAT", "jsonl")
    records = []
    for f in sorted(p.parent.glob(f"{p.name}*")):
        if f.is_file():
            with open(f, "r", encoding="utf-8") as fp:
                for line in fp:
                    line = line.strip()
                    if not line:
                        continue
                    if fmt in ("json", "jsonl"):
                        records.append(json.loads(line))
                    elif fmt == "yaml":
                        import yaml
                        records.append(yaml.safe_load(line))
                    elif fmt == "msgpack":
                        import msgpack
                        records.append(msgpack.unpackb(line.encode("latin-1"), raw=False))
    return records
from typing import Any

# Assuming these are imported from a local module; adjust as needed
try:
    from .tools import execute_tool
    from .ui import print_scalp_ui
    from .output import write_llm_output
except ImportError:
    # Fallback for standalone execution or different project structure
    from tools import execute_tool
    from ui import print_scalp_ui
    from output import write_llm_output


def run(**kwargs: Any) -> None:
    """AIChat entrypoint with permissive argument intake and envelope routing."""
    out_fmt = kwargs.get("output_format", "jsonl")
    no_col = kwargs.get("no_color", False)
    quiet = kwargs.get("quiet", False)
    json_only = kwargs.get("json_only", False)
    
    try:
        result = execute_tool(**kwargs)
    except Exception as e:
        # Structured error envelope for downstream consumers
        result = {"error": str(e), "status": "failed"}
        if not json_only:
            print_scalp_ui(result, no_color=no_col, quiet=quiet)
        write_llm_output(result, out_fmt)
        return

    if not json_only:
        print_scalp_ui(result, no_color=no_col, quiet=quiet)
    write_llm_output(result, out_fmt)
import argparse
import os
import sys
from typing import Any, Dict, List, Optional, Union


def env_default(env_var: str, default: Any = None) -> Dict[str, Any]:
    """Return argparse kwargs with default from environment variable."""
    value = os.getenv(env_var, default)
    if value is None:
        return {"required": True}
    if isinstance(default, bool):
        return {"default": value.lower() in ("1", "true", "yes", "on"), "action": "store_true"}
    return {"default": value}


def _positive_float(value: str) -> float:
    f = float(value)
    if f <= 0:
        raise argparse.ArgumentTypeError(f"{value} must be positive")
    return f


def _positive_int(value: str) -> int:
    i = int(value)
    if i <= 0:
        raise argparse.ArgumentTypeError(f"{value} must be positive")
    return i


def _bps(value: str) -> float:
    f = float(value)
    if f < 0:
        raise argparse.ArgumentTypeError(f"{value} must be non-negative")
    return f


def _comma_list(value: str) -> List[str]:
    return [v.strip().upper() for v in value.split(",") if v.strip()]


def _parse_risk_reward(value: str) -> float:
    try:
        parts = value.split(":")
        if len(parts) == 2:
            return float(parts[0]) / float(parts[1])
        return float(value)
    except (ValueError, ZeroDivisionError):
        raise argparse.ArgumentTypeError(f"Invalid risk-reward format: {value}. Use '1.5' or '3:1'")


class _EnvVarAction(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        for v in values:
            if "=" in v:
                k, val = v.split("=", 1)
                os.environ[k] = val
            else:
                parser.error(f"--env-var requires KEY=VALUE format, got: {v}")


def _build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="micro_scalper_tool.py",
        description=f"Enterprise Autonomous Bybit Micro-Scalper v{__version__}",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
        allow_abbrev=False,
    )

    # Symbol selection (mutually exclusive)
    sym_group = p.add_mutually_exclusive_group()
    sym_group.add_argument(
        "--symbols",
        type=_comma_list,
        **env_default("SCALP_SYMBOLS", "BTCUSDT,ETHUSDT,BNBUSDT,ADAUSDT,SOLUSDT"),
        help="Comma-separated list of symbols to trade (e.g., BTCUSDT,ETHUSDT)",
    )
    sym_group.add_argument(
        "--symbol",
        type=str.upper,
        **env_default("SCALP_SYMBOL"),
        help="Single symbol to trade (overrides --symbols)",
    )

    # Position sizing
    pos_group = p.add_argument_group("Position Sizing")
    pos_group.add_argument(
        "--side",
        type=str.capitalize,
        choices=["Buy", "Sell"],
        help="Force order side (default: auto-detect from signal)",
    )
    pos_group.add_argument(
        "--target",
        type=_positive_float,
        **env_default("SCALP_TARGET", "0.02"),
        help="Target profit as fraction (e.g., 0.02 = 2%%)",
    )
    pos_group.add_argument(
        "--target-profit",
        dest="target_profit",
        type=_positive_float,
        help="Alias for --target",
    )
    pos_group.add_argument(
        "--leverage",
        type=_positive_int,
        **env_default("SCALP_LEVERAGE", "50"),
        help="Leverage multiplier",
    )
    pos_group.add_argument(
        "--pos-value",
        dest="pos_value",
        type=_positive_float,
        default=50.0,
        help="Position size in quote currency (USDT)",
    )
    pos_group.add_argument(
        "--pos-pct",
        dest="pos_pct",
        type=float,
        default=0.0,
        help="Position size as percentage of available balance (0 = disabled)",
    )

    # Risk management
    risk_group = p.add_argument_group("Risk Management")
    risk_group.add_argument(
        "--spread-max-bps",
        dest="spread_max_bps",
        type=_bps,
        default=15.0,
        help="Maximum spread in basis points",
    )
    risk_group.add_argument(
        "--max-positions",
        dest="max_positions",
        type=_positive_int,
        default=1,
        help="Maximum concurrent positions per symbol",
    )
    risk_group.add_argument(
        "--risk-reward",
        dest="risk_reward",
        type=_parse_risk_reward,
        default=1.0,
        help="Risk:reward ratio (e.g., 1.5 or 3:1)",
    )
    risk_group.add_argument(
        "--trailing-stop",
        dest="trailing_stop",
        type=_positive_float,
        default=None,
        help="Trailing stop distance as fraction (e.g., 0.01 = 1%%)",
    )
    risk_group.add_argument(
        "--max-loss-trade",
        dest="max_loss_trade",
        type=_positive_float,
        default=0.05,
        help="Maximum loss per trade as fraction of position",
    )
    risk_group.add_argument(
        "--daily-loss-cap",
        dest="daily_loss_cap",
        type=_positive_float,
        default=0.50,
        help="Daily loss limit as fraction of starting equity",
    )
    risk_group.add_argument(
        "--max-drawdown-pct",
        dest="max_drawdown_pct",
        type=_bps,
        default=15.0,
        help="Maximum portfolio drawdown percentage",
    )

    # Execution control
    exec_group = p.add_argument_group("Execution Control")
    exec_group.add_argument(
        "--max-workers",
        dest="max_workers",
        type=_positive_int,
        default=5,
        help="Maximum concurrent worker threads",
    )
    exec_group.add_argument(
        "--cooldown",
        type=_positive_int,
        default=120,
        help="Cooldown seconds between trades on same symbol",
    )
    exec_group.add_argument(
        "--loop",
        action="store_true",
        default=False,
        help="Run continuously in loop mode",
    )
    exec_group.add_argument(
        "--loop-delay",
        dest="loop_delay",
        type=_positive_int,
        default=30,
        help="Delay between loop iterations in seconds",
    )
    exec_group.add_argument(
        "--dry-run",
        action="store_true",
        **env_default("SCALP_DRY_RUN", False),
        help="Simulate trades without placing orders",
    )

    # AI / LLM
    ai_group = p.add_argument_group("AI Enhancement")
    ai_group.add_argument(
        "--enable-ai",
        action="store_true",
        default=False,
        help="Enable AI-powered signal filtering",
    )
    ai_group.add_argument(
        "--ollama-host",
        dest="ollama_host",
        type=str,
        default="http://localhost:11434",
        help="Ollama API endpoint",
    )
    ai_group.add_argument(
        "--ollama-model",
        dest="ollama_model",
        type=str,
        default="nemotron-3-nano:30b-cloud",
        help="Ollama model name",
    )

    # State & logging
    state_group = p.add_argument_group("State & Logging")
    state_group.add_argument(
        "--state-file",
        dest="state_file",
        type=str,
        default=None,
        help="Path to persist bot state (JSON)",
    )
    state_group.add_argument(
        "--trade-log",
        dest="trade_log",
        type=str,
        default=None,
        help="Path to trade log file (JSONL)",
    )
    state_group.add_argument(
        "--output-format",
        dest="output_format",
        choices=["json", "jsonl"],
        default="jsonl",
        help="Output format for logs",
    )

    # Caching
    cache_group = p.add_argument_group("Caching")
    cache_group.add_argument(
        "--cache-ttl",
        dest="cache_ttl",
        type=_positive_int,
        default=DEFAULT_CACHE_TTL,
        help="Cache TTL in seconds",
    )
    cache_group.add_argument(
        "--cache-dir",
        dest="cache_dir",
        type=str,
        default=None,
        help="Cache directory path",
    )
    cache_group.add_argument(
        "--use-cache",
        dest="use_cache",
        action="store_true",
        default=False,
        help="Enable response caching",
    )
    cache_group.add_argument(
        "--clear-cache",
        dest="clear_cache",
        action="store_true",
        default=False,
        help="Clear cache on startup",
    )

    # Environment & config
    env_group = p.add_argument_group("Environment")
    env_group.add_argument(
        "--env-var",
        action="append",
        dest="env_vars",
        default=[],
        metavar="KEY=VALUE",
        help="Set environment variable (repeatable)",
        action=_EnvVarAction,
    )
    env_group.add_argument(
        "--schema",
        action="store_true",
        default=False,
        help="Print JSON schema for config and exit",
    )

    # Output control
    out_group = p.add_argument_group("Output Control")
    out_group.add_argument(
        "--json-only",
        dest="json_only",
        action="store_true",
        default=False,
        help="Output only JSON (suppress human-readable)",
    )
    out_group.add_argument(
        "--quiet", "-q",
        action="store_true",
        default=False,
        help="Suppress non-error output",
    )
    out_group.add_argument(
        "--no-color",
        dest="no_color",
        action="store_true",
        default=False,
        help="Disable colored output",
    )
    out_group.add_argument(
        "--verbose", "-v",
        action="store_true",
        default=False,
        help="Enable debug logging",
    )

    return p


__version__ = "2.1.0"
DEFAULT_CACHE_TTL = 300
import sys
import json
import time
import contextlib
import argparse
import signal
import logging
from pathlib import Path
from dataclasses import dataclass, fields
from typing import Optional, Dict, Any, List, Callable
from concurrent.futures import ThreadPoolExecutor, as_completed

# --- Constants & Configuration ---
EXIT_SUCCESS = 0
EXIT_FAILURE = 1
NEON_GREEN = "\033[92m"
NEON_CYAN = "\033[96m"
RESET = "\033[0m"

# --- Logging Setup ---
logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
log = logging.getLogger("micro_scalp")

# --- Data Classes ---
@dataclass
class ScalpConfig:
    symbols: Optional[List[str]] = None
    symbol: Optional[str] = None
    side: Optional[str] = None
    target: Optional[float] = None
    target_profit: Optional[float] = None
    leverage: int = 1
    pos_value: Optional[float] = None
    pos_pct: Optional[float] = None
    spread_max_bps: float = 10.0
    max_positions: int = 5
    max_workers: int = 4
    cooldown: int = 60
    loop: bool = False
    loop_delay: float = 60.0
    risk_reward: float = 2.0
    trailing_stop: bool = False
    max_loss_trade: float = 0.02
    daily_loss_cap: float = 0.05
    max_drawdown_pct: float = 0.10
    state_file: str = "state.json"
    trade_log: str = "trades.log"
    dry_run: bool = False
    enable_ai: bool = False
    ollama_host: str = "http://localhost:11434"
    ollama_model: str = "llama3"
    output_format: str = "text"
    no_color: bool = False
    verbose: bool = False
    quiet: bool = False
    env_vars: bool = False
    use_cache: bool = True
    cache_ttl: int = 300
    cache_dir: str = ".cache"
    schema: bool = False
    clear_cache: bool = False
    json_only: bool = False

    @classmethod
    def from_namespace(cls, ns: argparse.Namespace) -> "ScalpConfig":
        valid_fields = {f.name for f in fields(cls)}
        return cls(**{k: v for k, v in vars(ns).items() if k in valid_fields})

# --- Utility Classes ---
class GracefulShutdown:
    """Context manager for handling SIGINT/SIGTERM gracefully."""
    def __init__(self):
        self._stop = False
        self._original_sigint = signal.getsignal(signal.SIGINT)
        self._original_sigterm = signal.getsignal(signal.SIGTERM)

    def __enter__(self):
        signal.signal(signal.SIGINT, self._handle_signal)
        signal.signal(signal.SIGTERM, self._handle_signal)
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        signal.signal(signal.SIGINT, self._original_sigint)
        signal.signal(signal.SIGTERM, self._original_sigterm)
        return False

    def _handle_signal(self, signum, frame):
        log.info(f"Received signal {signum}, shutting down gracefully...")
        self._stop = True

    def should_stop(self) -> bool:
        return self._stop

class ToolCache:
    def __init__(self, cache_dir: str):
        self.cache_dir = Path(cache_dir)
        self.cache_dir.mkdir(parents=True, exist_ok=True)

    def clear(self):
        with contextlib.suppress(Exception):
            for f in self.cache_dir.glob("*.json"):
                f.unlink(missing_ok=True)

# --- Placeholder Implementations (Stubs for Runnability) ---
def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Micro Scalper Bot")
    # Add arguments matching ScalpConfig fields
    for field in fields(ScalpConfig):
        kwargs = {"default": field.default, "help": f"Config: {field.name}"}
        if field.type == bool:
            parser.add_argument(f"--{field.name.replace('_', '-')}", action="store_true", **kwargs)
        elif field.type == Optional[List[str]]:
            parser.add_argument(f"--{field.name.replace('_', '-')}", nargs="+", **kwargs)
        else:
            parser.add_argument(f"--{field.name.replace('_', '-')}", type=field.type, **kwargs)
    return parser

def generate_tool_schema() -> Dict[str, Any]:
    return {"name": "micro_scalp", "description": "Scalping tool", "parameters": {f.name: {"type": "string"} for f in fields(ScalpConfig)}}

def _cprint(msg: str, no_color: bool = False):
    if no_color:
        msg = msg.replace(NEON_GREEN, "").replace(NEON_CYAN, "").replace(RESET, "")
    print(msg)

def execute_tool(**kwargs) -> Dict[str, Any]:
    """Stub for actual trading logic."""
    log.debug("Executing tool with config: %s", kwargs)
    return {"success": True, "exit_code": EXIT_SUCCESS, "data": "Mock result", "type": "Success"}

def print_scalp_ui(res: Dict[str, Any], no_color: bool = False, quiet: bool = False):
    if not quiet:
        _cprint(f"Result: {res.get('data')}", no_color=no_color)

def write_llm_output(res: Dict[str, Any], output_format: str):
    if output_format == "json":
        sys.stdout.write(json.dumps(res, indent=2) + "\n")

# --- Logic Upgrades ---

def validate_config(config: ScalpConfig) -> List[str]:
    """Upgrade 1: Centralized Config Validation."""
    errors = []
    if config.leverage <= 0:
        errors.append("Leverage must be positive.")
    if config.loop_delay <= 0:
        errors.append("Loop delay must be positive.")
    if config.max_positions <= 0:
        errors.append("Max positions must be positive.")
    if config.risk_reward <= 0:
        errors.append("Risk/Reward must be positive.")
    if not config.symbols and not config.symbol:
        errors.append("At least one symbol (--symbol or --symbols) is required.")
    return errors

def run_scalp_cycle(config: ScalpConfig, shutdown: GracefulShutdown) -> Dict[str, Any]:
    """Upgrade 2: Extracted Cycle Logic for Testability & Concurrency."""
    # In a real scenario, this might use ThreadPoolExecutor for multi-symbol
    res = execute_tool(**config.__dict__)
    return res

def handle_loop_mode(config: ScalpConfig, shutdown: GracefulShutdown) -> int:
    """Upgrade 3: Robust Loop Handling with Precise Timing & Health Checks."""
    log.info(f"Continuous loop started (delay {config.loop_delay}s)... Ctrl-C to abort")
    
    next_run = time.monotonic()
    while not shutdown.should_stop():
        cycle_start = time.monotonic()
        
        res = run_scalp_cycle(config, shutdown)
        
        if not config.json_only:
            print_scalp_ui(res, no_color=config.no_color, quiet=config.quiet)
        write_llm_output(res, config.output_format)

        # Hard stop conditions
        if not res.get("success") and res.get("type") in ("DailyLossCapExceeded", "MaxDrawdownExceeded"):
            log.error(f"Hard stop triggered: {res.get('type')}")
            break
        
        # Precise sleep accounting for execution time
        elapsed = time.monotonic() - cycle_start
        sleep_time = max(0.0, config.loop_delay - elapsed)
        
        # Sleep in small chunks to remain responsive to shutdown
        while sleep_time > 0 and not shutdown.should_stop():
            chunk = min(1.0, sleep_time)
            time.sleep(chunk)
            sleep_time -= chunk
            
    return EXIT_SUCCESS

# --- Main Entry Point ---
def main() -> int:
    parser = _build_parser()
    args = parser.parse_args()
    config = ScalpConfig.from_namespace(args)

    # Upgrade: Validation Early Exit
    validation_errors = validate_config(config)
    if validation_errors:
        for err in validation_errors:
            log.error("Config Error: %s", err)
        return EXIT_FAILURE

    if config.schema:
        sys.stdout.write(json.dumps(generate_tool_schema(), indent=2) + "\n")
        return EXIT_SUCCESS

    if config.clear_cache:
        cache = ToolCache(cache_dir=config.cache_dir)
        cache.clear()
        if not config.quiet and not config.json_only:
            _cprint(f"{NEON_GREEN}Cleared tool cache.{RESET}", no_color=config.no_color)
        return EXIT_SUCCESS

    # Configure logging level based on verbosity
    if config.verbose:
        log.setLevel(logging.DEBUG)
    elif config.quiet:
        log.setLevel(logging.WARNING)

    with GracefulShutdown() as shutdown:
        if config.loop:
            return handle_loop_mode(config, shutdown)
        else:
            res = run_scalp_cycle(config, shutdown)
            if not config.json_only:
                print_scalp_ui(res, no_color=config.no_color, quiet=config.quiet)
            write_llm_output(res, config.output_format)
            return res.get("exit_code", EXIT_SUCCESS)

if __name__ == "__main__":
    sys.exit(main())
