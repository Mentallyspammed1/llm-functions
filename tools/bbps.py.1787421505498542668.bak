import os
import re
from typing import Optional

class SecurityValidator:
    BLOCKED_ENV_VARS: frozenset[str] = frozenset({
        "PATH", "LD_LIBRARY_PATH", "LD_PRELOAD", "DYLD_INSERT_LIBRARIES",
        "PYTHONPATH", "PYTHONHOME", "PYTHONEXECUTABLE", "PYTHONSTARTUP",
        "PYTHONUSERBASE", "PYTHONBREAKPOINT", "PYTHONDEVMODE", "PYTHONINSPECT",
        "PYTHONUNBUFFERED", "PYTHONVERBOSE", "PYTHONWARNINGS", "PYTHONFAULTHANDLER",
        "PYTHONTRACEMALLOC", "PYTHONASYNCIODEBUG", "PYTHONHASHSEED",
        "PERL5LIB", "PERL5OPT", "PERL_MM_OPT", "PERL_MB_OPT",
        "RUBYLIB", "RUBYOPT", "GEM_PATH", "GEM_HOME",
        "NODE_PATH", "NODE_OPTIONS", "NPM_CONFIG_PREFIX",
        "JAVA_HOME", "JAVA_TOOL_OPTIONS", "_JAVA_OPTIONS",
        "CLASSPATH", "ANT_HOME", "MAVEN_HOME", "GRADLE_HOME",
        "GO_PATH", "GO_BIN", "GOPATH", "GOBIN",
        "CARGO_HOME", "RUSTUP_HOME", "RUSTFLAGS",
        "DOTNET_ROOT", "DOTNET_CLI_TELEMETRY_OPTOUT",
        "HOME", "USER", "USERNAME", "LOGNAME", "SHELL", "TERM",
        "TMPDIR", "TMP", "TEMP", "TMPDIR",
        "SSH_AUTH_SOCK", "SSH_AGENT_PID", "SSH_CLIENT", "SSH_CONNECTION",
        "SSH_TTY", "SSH_KEYFILE", "SSH_ASKPASS",
        "GPG_AGENT_INFO", "GPG_TTY",
        "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN",
        "AWS_DEFAULT_REGION", "AWS_PROFILE", "AWS_ROLE_ARN",
        "AZURE_CLIENT_ID", "AZURE_CLIENT_SECRET", "AZURE_TENANT_ID",
        "GOOGLE_APPLICATION_CREDENTIALS", "GCLOUD_PROJECT",
        "DOCKER_CONFIG", "DOCKER_CERT_PATH", "DOCKER_HOST", "DOCKER_TLS_VERIFY",
        "KUBECONFIG", "HELM_HOME",
        "VAULT_ADDR", "VAULT_TOKEN", "VAULT_NAMESPACE",
        "CONSUL_HTTP_ADDR", "CONSUL_HTTP_TOKEN",
        "ETCDCTL_ENDPOINTS", "ETCDCTL_CERT", "ETCDCTL_KEY", "ETCDCTL_CACERT",
    })

    ENV_KEY_PATTERN: re.Pattern[str] = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*$')
    MAX_KEY_LENGTH: int = 256
    MAX_VALUE_LENGTH: int = 4096

    @staticmethod
    def sanitize_env_vars(env_vars: Optional[list[str]]) -> tuple[dict[str, str], list[str]]:
        """
        Sanitize and validate environment variable overrides.

        Args:
            env_vars: List of strings in "KEY=VALUE" format, or None.

        Returns:
            Tuple of (sanitized_env_dict, warnings_list).
        """
        if not env_vars:
            return {}, []

        sanitized: dict[str, str] = {}
        warnings: list[str] = []

        for entry in env_vars:
            if not isinstance(entry, str):
                warnings.append(f"Ignored non-string env var entry: {type(entry).__name__}")
                continue

            if "=" not in entry:
                warnings.append(f"Ignored malformed env var '{entry}' (must be KEY=VALUE)")
                continue

            k, v = entry.split("=", 1)
            k_clean = k.strip()
            v_clean = v.strip()

            if not k_clean:
                warnings.append(f"Ignored env var with empty key: '{entry}'")
                continue

            if len(k_clean) > SecurityValidator.MAX_KEY_LENGTH:
                warnings.append(f"Ignored env var with key too long ({len(k_clean)} > {SecurityValidator.MAX_KEY_LENGTH}): '{k_clean[:50]}...'")
                continue

            if len(v_clean) > SecurityValidator.MAX_VALUE_LENGTH:
                warnings.append(f"Ignored env var with value too long ({len(v_clean)} > {SecurityValidator.MAX_VALUE_LENGTH}) for key '{k_clean}'")
                continue

            if not SecurityValidator.ENV_KEY_PATTERN.match(k_clean):
                warnings.append(f"Ignored env var with invalid key format: '{k_clean}' (must match ^[A-Za-z_][A-Za-z0-9_]*$)")
                continue

            k_upper = k_clean.upper()
            if k_upper in SecurityValidator.BLOCKED_ENV_VARS:
                warnings.append(f"Blocked dangerous environment variable override: '{k_clean}'")
                continue

            if k_clean in sanitized:
                warnings.append(f"Duplicate env var key '{k_clean}', last value wins")

            sanitized[k_clean] = v_clean

        return sanitized, warnings

    @classmethod
    def is_blocked(cls, key: str) -> bool:
        """Check if an environment variable key is blocked."""
        return key.upper() in cls.BLOCKED_ENV_VARS

    @classmethod
    def validate_key(cls, key: str) -> tuple[bool, Optional[str]]:
        """
        Validate an environment variable key.

        Returns:
            Tuple of (is_valid, error_message_or_none).
        """
        if not key:
            return False, "Key cannot be empty"
        if len(key) > cls.MAX_KEY_LENGTH:
            return False, f"Key exceeds maximum length of {cls.MAX_KEY_LENGTH}"
        if not cls.ENV_KEY_PATTERN.match(key):
            return False, "Key must match pattern ^[A-Za-z_][A-Za-z0-9_]*$"
        if key.upper() in cls.BLOCKED_ENV_VARS:
            return False, f"Key '{key}' is blocked for security reasons"
        return True, None

    @classmethod
    def validate_value(cls, value: str) -> tuple[bool, Optional[str]]:
        """
        Validate an environment variable value.

        Returns:
            Tuple of (is_valid, error_message_or_none).
        """
        if len(value) > cls.MAX_VALUE_LENGTH:
            return False, f"Value exceeds maximum length of {cls.MAX_VALUE_LENGTH}"
        return True, None
from __future__ import annotations

import os
import uuid
from typing import Any, Optional

# ==============================================================================
# Constants & Types
# ==============================================================================

EXIT_INVALID_INPUT = 2
VALID_SIDES = {"BUY", "SELL"}
VALID_OUTPUT_FORMATS = {"jsonl", "json", "csv", "text"}

# ==============================================================================
# Helper Classes & Functions
# ==============================================================================

class ToolError(Exception):
    def __init__(
        self,
        message: str,
        exit_code: int,
        error_type: str,
        trace_id: str,
    ):
        super().__init__(message)
        self.message = message
        self.exit_code = exit_code
        self.error_type = error_type
        self.trace_id = trace_id

    def to_dict(self) -> dict[str, Any]:
        return {
            "error": self.error_type,
            "message": self.message,
            "exit_code": self.exit_code,
            "trace_id": self.trace_id,
        }


def _clean_str(value: Optional[str]) -> str:
    return (value or "").strip()


def parse_safe_float(value: Any) -> Optional[float]:
    if value is None:
        return None
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


# ==============================================================================
# Input Validation
# ==============================================================================

def validate_inputs(
    symbols: Optional[str] = None,
    symbol: Optional[str] = None,
    side: Optional[str] = None,
    target: Any = None,
    leverage: Any = None,
    spread_max_bps: Any = None,
    max_loss_trade: Any = None,
    daily_loss_cap: Any = None,
    output_format: str = "jsonl",
) -> Optional[dict[str, Any]]:
    trace_id = str(uuid.uuid4())
    if not (symbols or symbol):
        return ToolError(
            "At least one of --symbols or --symbol is required.",
            EXIT_INVALID_INPUT,
            "ValidationError",
            trace_id=trace_id,
        ).to_dict()
    if side and _clean_str(side).upper() not in VALID_SIDES:
        return ToolError(
            f"Invalid side '{side}'. Allowed: Buy, Sell",
            EXIT_INVALID_INPUT,
            "ValidationError",
            trace_id=trace_id,
        ).to_dict()
    if output_format not in VALID_OUTPUT_FORMATS:
        return ToolError(
            f"Invalid output format '{output_format}'. Allowed: {sorted(VALID_OUTPUT_FORMATS)}",
            EXIT_INVALID_INPUT,
            "ValidationError",
            trace_id=trace_id,
        ).to_dict()
    for name, val, min_v in [
        ("target", target, 0),
        ("leverage", leverage, 1),
        ("spread_max_bps", spread_max_bps, 0),
        ("max_loss_trade", max_loss_trade, 0),
        ("daily_loss_cap", daily_loss_cap, 0),
    ]:
        parsed = parse_safe_float(val)
        if parsed is not None and parsed < min_v:
            return ToolError(
                f"{name} must be >= {min_v} (received: {val}).",
                EXIT_INVALID_INPUT,
                "ValidationError",
                trace_id=trace_id,
            ).to_dict()
    lev = parse_safe_float(leverage)
    if lev is not None and lev > 125:
        return ToolError(
            f"Leverage must be <= 125 (received: {leverage}).",
            EXIT_INVALID_INPUT,
            "ValidationError",
            trace_id=trace_id,
        ).to_dict()
    return None


# ==============================================================================
# SECTION 5: Agent Execution Context & Path Resolution
# ==============================================================================


def get_builtin_var(name: str, default: Optional[str] = None) -> Optional[str]:
    return (
        os.environ.get(f"LLM_AGENT_VAR_{name}")
        or os.environ.get(f"LLM_AGENT_VAR_{name.lower()}")
        or os.environ.get(f"LLM_AGENT_VAR_{name.upper()}")
        or default
    )


# ==============================================================================
# Logic Upgrades & Additions
# ==============================================================================

def validate_symbol_format(symbol: str) -> bool:
    """Validate symbol follows exchange format (e.g., BTCUSDT, ETH-USD)."""
    import re
    return bool(re.match(r"^[A-Z0-9]{2,10}[-_]?[A-Z0-9]{2,10}$", symbol.upper()))


def normalize_symbol(symbol: str) -> str:
    """Normalize symbol to standard format (BASEQUOTE)."""
    cleaned = symbol.upper().replace("-", "").replace("_", "")
    if len(cleaned) >= 6:
        return cleaned
    raise ValueError(f"Invalid symbol format: {symbol}")


def compute_position_size(
    equity: float,
    risk_pct: float,
    entry_price: float,
    stop_price: float,
    leverage: float = 1.0,
) -> float:
    """Calculate position size based on risk management rules."""
    if entry_price <= 0 or stop_price <= 0:
        raise ValueError("Entry and stop prices must be positive")
    if equity <= 0:
        raise ValueError("Equity must be positive")
    if not 0 < risk_pct <= 1:
        raise ValueError("Risk percentage must be between 0 and 1")
    if leverage < 1:
        raise ValueError("Leverage must be >= 1")

    risk_amount = equity * risk_pct
    price_diff = abs(entry_price - stop_price)
    if price_diff == 0:
        raise ValueError("Entry and stop prices cannot be equal")

    raw_size = risk_amount / price_diff
    return round(raw_size * leverage, 8)


def check_daily_loss_limit(
    current_daily_loss: float,
    daily_loss_cap: float,
) -> tuple[bool, str]:
    """Check if daily loss limit is breached. Returns (allowed, message)."""
    if current_daily_loss >= daily_loss_cap:
        return False, f"Daily loss cap reached: {current_daily_loss:.2f} >= {daily_loss_cap:.2f}"
    if current_daily_loss >= daily_loss_cap * 0.8:
        return True, f"Warning: Approaching daily loss cap ({current_daily_loss:.2f}/{daily_loss_cap:.2f})"
    return True, "OK"


def build_order_payload(
    symbol: str,
    side: str,
    qty: float,
    order_type: str = "MARKET",
    price: Optional[float] = None,
    reduce_only: bool = False,
    client_order_id: Optional[str] = None,
) -> dict[str, Any]:
    """Build standardized order payload for exchange submission."""
    payload = {
        "symbol": normalize_symbol(symbol),
        "side": side.upper(),
        "type": order_type.upper(),
        "quantity": qty,
        "reduceOnly": reduce_only,
    }
    if price is not None:
        payload["price"] = price
    if client_order_id:
        payload["clientOrderId"] = client_order_id
    return payload
from __future__ import annotations
import os
from functools import lru_cache
from pathlib import Path
from typing import Optional, Union

try:
    from agent_builtins import get_builtin_var
except ImportError:
    def get_builtin_var(name: str) -> Optional[str]:
        return os.environ.get(name.lstrip("_").rstrip("_").upper())


@lru_cache(maxsize=128)
def resolve_agent_path(target_str: Optional[Union[str, os.PathLike]]) -> Optional[Path]:
    if not target_str:
        return None
    try:
        raw = Path(target_str).expanduser()
        if raw.is_absolute():
            return raw.resolve(strict=False)
        agent_cwd = get_builtin_var("__cwd__")
        if agent_cwd:
            base = Path(agent_cwd).expanduser().resolve(strict=False)
            return (base / raw).resolve(strict=False)
        return raw.resolve(strict=False)
    except (OSError, ValueError):
        return None


def resolve_agent_paths(*targets: Optional[Union[str, os.PathLike]]) -> list[Path]:
    return [p for t in targets if (p := resolve_agent_path(t)) is not None]


def ensure_agent_path(target_str: Optional[Union[str, os.PathLike]], *, mkdir: bool = True, parents: bool = True, exist_ok: bool = True) -> Optional[Path]:
    path = resolve_agent_path(target_str)
    if path and mkdir:
        try:
            path.mkdir(parents=parents, exist_ok=exist_ok)
        except OSError:
            return None
    return path


def is_within_agent_root(target_str: Optional[Union[str, os.PathLike]], root: Optional[Union[str, os.PathLike]] = None) -> bool:
    target = resolve_agent_path(target_str)
    if not target:
        return False
    root_path = resolve_agent_path(root) if root else Path(get_builtin_var("__cwd__") or ".").resolve(strict=False)
    try:
        target.relative_to(root_path)
        return True
    except ValueError:
        return False
import os
from typing import Any


def env_default(env_name: str, fallback: Any = None) -> dict[str, Any]:
    val = os.getenv(env_name)
    if val is not None:
        return {"default": val}
    if fallback is not None:
        return {"default": fallback}
    return {}


# ==============================================================================
# SECTION 6: Cache Engine & State Persistence Manager
# ==============================================================================


class CacheEngine:
    """Thread-safe cache with TTL support and persistence."""

    def __init__(self, ttl_seconds: int = 300, max_size: int = 10000):
        self._cache: dict[str, tuple[Any, float]] = {}
        self._ttl = ttl_seconds
        self._max_size = max_size
        self._lock = __import__("threading").RLock()

    def get(self, key: str, default: Any = None) -> Any:
        with self._lock:
            if key not in self._cache:
                return default
            value, expiry = self._cache[key]
            if __import__("time").time() > expiry:
                del self._cache[key]
                return default
            return value

    def set(self, key: str, value: Any, ttl: int | None = None) -> None:
        with self._lock:
            if len(self._cache) >= self._max_size and key not in self._cache:
                self._evict_oldest()
            expiry = __import__("time").time() + (ttl or self._ttl)
            self._cache[key] = (value, expiry)

    def delete(self, key: str) -> bool:
        with self._lock:
            if key in self._cache:
                del self._cache[key]
                return True
            return False

    def clear(self) -> None:
        with self._lock:
            self._cache.clear()

    def _evict_oldest(self) -> None:
        if not self._cache:
            return
        oldest_key = min(self._cache.keys(), key=lambda k: self._cache[k][1])
        del self._cache[oldest_key]

    def persist(self, filepath: str) -> None:
        import json
        import time

        with self._lock:
            data = {
                k: {"value": v, "expiry": e}
                for k, (v, e) in self._cache.items()
                if e > time.time()
            }
        with open(filepath, "w") as f:
            json.dump(data, f)

    def load(self, filepath: str) -> int:
        import json
        import time

        try:
            with open(filepath) as f:
                data = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            return 0

        now = time.time()
        loaded = 0
        with self._lock:
            for k, v in data.items():
                if v["expiry"] > now:
                    self._cache[k] = (v["value"], v["expiry"])
                    loaded += 1
        return loaded


class StatePersistenceManager:
    """Manages persistent state with versioning and atomic writes."""

    def __init__(self, state_dir: str = "./state"):
        self._state_dir = state_dir
        os.makedirs(state_dir, exist_ok=True)
        self._lock = __import__("threading").RLock()

    def save_state(self, key: str, state: dict[str, Any], version: int = 1) -> None:
        import json
        import tempfile

        filepath = os.path.join(self._state_dir, f"{key}.json")
        payload = {"version": version, "data": state, "timestamp": __import__("time").time()}

        with self._lock:
            with tempfile.NamedTemporaryFile(
                mode="w", dir=self._state_dir, delete=False, suffix=".tmp"
            ) as tmp:
                json.dump(payload, tmp)
                tmp_path = tmp.name
            os.replace(tmp_path, filepath)

    def load_state(self, key: str, min_version: int = 1) -> dict[str, Any] | None:
        import json

        filepath = os.path.join(self._state_dir, f"{key}.json")
        try:
            with open(filepath) as f:
                payload = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            return None

        if payload.get("version", 0) < min_version:
            return None
        return payload.get("data")

    def delete_state(self, key: str) -> bool:
        filepath = os.path.join(self._state_dir, f"{key}.json")
        try:
            os.remove(filepath)
            return True
        except FileNotFoundError:
            return False

    def list_states(self) -> list[str]:
        try:
            return [
                f[:-5] for f in os.listdir(self._state_dir) if f.endswith(".json")
            ]
        except FileNotFoundError:
            return []


def create_cache_engine(ttl_seconds: int = 300, max_size: int = 10000) -> CacheEngine:
    """Factory function for CacheEngine."""
    return CacheEngine(ttl_seconds=ttl_seconds, max_size=max_size)


def create_state_manager(state_dir: str = "./state") -> StatePersistenceManager:
    """Factory function for StatePersistenceManager."""
    return StatePersistenceManager(state_dir=state_dir)
import os
import json
import time
import hashlib
import threading
import contextlib
from pathlib import Path
from typing import Optional, Any, Dict, List
from dataclasses import dataclass, field


DEFAULT_CACHE_TTL = 3600
DEFAULT_CACHE_MAX_SIZE_MB = 100


class ToolJSONEncoder(json.JSONEncoder):
    def default(self, obj: Any) -> Any:
        if hasattr(obj, "__dict__"):
            return obj.__dict__
        if hasattr(obj, "to_dict"):
            return obj.to_dict()
        if isinstance(obj, (set, frozenset)):
            return list(obj)
        if isinstance(obj, bytes):
            return obj.decode("utf-8", errors="replace")
        return super().default(obj)


@dataclass
class CacheStats:
    total_entries: int = 0
    total_size_bytes: int = 0
    expired_entries: int = 0
    oldest_entry: Optional[float] = None
    newest_entry: Optional[float] = None


class ToolCache:
    def __init__(
        self,
        cache_dir: Optional[Path | str] = None,
        ttl: int = DEFAULT_CACHE_TTL,
        max_size_mb: int = DEFAULT_CACHE_MAX_SIZE_MB,
    ) -> None:
        if cache_dir:
            self.cache_dir = Path(cache_dir).resolve()
        elif "LLM_TOOL_CACHE_DIR" in os.environ:
            self.cache_dir = Path(os.environ["LLM_TOOL_CACHE_DIR"]).resolve()
        else:
            self.cache_dir = Path.home() / ".cache" / "aichat_scalper"
        self.ttl = ttl
        self.max_size_bytes = max_size_mb * 1024 * 1024
        self._lock = threading.RLock()
        with contextlib.suppress(OSError):
            self.cache_dir.mkdir(parents=True, exist_ok=True)

    def _hash_key(self, key_str: str) -> str:
        return hashlib.sha256(key_str.encode("utf-8")).hexdigest()

    def _get_cache_files(self) -> List[Path]:
        with contextlib.suppress(OSError):
            return list(self.cache_dir.glob("*.json"))
        return []

    def _enforce_max_size(self) -> None:
        files = self._get_cache_files()
        if not files:
            return
        total_size = sum(f.stat().st_size for f in files)
        if total_size <= self.max_size_bytes:
            return
        files.sort(key=lambda f: f.stat().st_mtime)
        for f in files:
            if total_size <= self.max_size_bytes:
                break
            with contextlib.suppress(OSError):
                total_size -= f.stat().st_size
                f.unlink()

    def get(self, key_str: str) -> Optional[dict[str, Any]]:
        cache_file = self.cache_dir / f"{self._hash_key(key_str)}.json"
        if not cache_file.exists():
            return None
        try:
            if (time.time() - cache_file.stat().st_mtime) > self.ttl:
                cache_file.unlink(missing_ok=True)
                return None
            with open(cache_file, "r", encoding="utf-8") as fp:
                return json.load(fp)
        except Exception:
            return None

    def set(self, key_str: str, value: Any) -> None:
        key_hash = self._hash_key(key_str)
        cache_file = self.cache_dir / f"{key_hash}.json"
        tmp_file = self.cache_dir / f"{key_hash}.tmp.{os.getpid()}"
        with self._lock:
            try:
                with open(tmp_file, "w", encoding="utf-8") as fp:
                    json.dump(value, fp, cls=ToolJSONEncoder, ensure_ascii=False)
                tmp_file.replace(cache_file)
                self._enforce_max_size()
            except Exception:
                with contextlib.suppress(OSError):
                    tmp_file.unlink(missing_ok=True)

    def delete(self, key_str: str) -> bool:
        cache_file = self.cache_dir / f"{self._hash_key(key_str)}.json"
        try:
            cache_file.unlink()
            return True
        except FileNotFoundError:
            return False
        except Exception:
            return False

    def clear(self) -> int:
        count = 0
        for f in self._get_cache_files():
            with contextlib.suppress(OSError):
                f.unlink()
                count += 1
        return count

    def cleanup_expired(self) -> int:
        count = 0
        now = time.time()
        for f in self._get_cache_files():
            try:
                if (now - f.stat().st_mtime) > self.ttl:
                    f.unlink()
                    count += 1
            except Exception:
                pass
        return count

    def stats(self) -> CacheStats:
        files = self._get_cache_files()
        if not files:
            return CacheStats()
        total_size = 0
        expired = 0
        mtimes = []
        now = time.time()
        for f in files:
            try:
                st = f.stat()
                total_size += st.st_size
                mtimes.append(st.st_mtime)
                if (now - st.st_mtime) > self.ttl:
                    expired += 1
            except Exception:
                pass
        return CacheStats(
            total_entries=len(files),
            total_size_bytes=total_size,
            expired_entries=expired,
            oldest_entry=min(mtimes) if mtimes else None,
            newest_entry=max(mtimes) if mtimes else None,
        )

    def __contains__(self, key_str: str) -> bool:
        return self.get(key_str) is not None

    def __len__(self) -> int:
        return len(self._get_cache_files())

    def __enter__(self) -> "ToolCache":
        return self

    def __exit__(self, exc_type, exc_val, exc_tb) -> None:
        self.cleanup_expired()

    async def aget(self, key_str: str) -> Optional[dict[str, Any]]:
        import asyncio
        return await asyncio.to_thread(self.get, key_str)

    async def aset(self, key_str: str, value: Any) -> None:
        import asyncio
        await asyncio.to_thread(self.set, key_str, value)

    async def adelete(self, key_str: str) -> bool:
        import asyncio
        return await asyncio.to_thread(self.delete, key_str)

    async def aclear(self) -> int:
        import asyncio
        return await asyncio.to_thread(self.clear)

    async def acleanup_expired(self) -> int:
        import asyncio
        return await asyncio.to_thread(self.cleanup_expired)

    async def astats(self) -> CacheStats:
        import asyncio
        return await asyncio.to_thread(self.stats)
from __future__ import annotations

import datetime
import json
import logging
import os
import threading
from pathlib import Path
from typing import Any, Optional

try:
    from .utils import resolve_agent_path, ToolJSONEncoder
except ImportError:
    def resolve_agent_path(path: Optional[str]) -> Optional[Path]:
        if path is None:
            return None
        p = Path(path).expanduser()
        if not p.is_absolute():
            p = Path.home() / ".config" / "scalper" / p
        return p

    class ToolJSONEncoder(json.JSONEncoder):
        def default(self, obj: Any) -> Any:
            if isinstance(obj, (datetime.datetime, datetime.date, Path)):
                return str(obj)
            if hasattr(obj, "__dict__"):
                return obj.__dict__
            return super().default(obj)


class ScalperStateManager:
    """Thread-safe state persistence with atomic writes and daily rollover."""

    def __init__(
        self,
        state_path: Optional[str] = None,
        ledger_path: Optional[str] = None,
        max_ledger_size_mb: int = 100,
        backup_count: int = 5,
    ) -> None:
        self.state_file = resolve_agent_path(state_path) or Path.home() / ".scalper_state.json"
        self.ledger_file = resolve_agent_path(ledger_path) or Path.home() / "trade_log.jsonl"
        self._lock = threading.RLock()
        self._max_ledger_bytes = max_ledger_size_mb * 1024 * 1024
        self._backup_count = backup_count
        self._schema_version = 2

    def load(self) -> dict[str, Any]:
        with self._lock:
            defaults = self._default_state()
            if not self.state_file.exists():
                return defaults
            try:
                with open(self.state_file, "r", encoding="utf-8") as fp:
                    data = json.load(fp)
            except (json.JSONDecodeError, OSError) as e:
                logging.warning(f"State file corrupted, loading defaults: {e}")
                return defaults

            data = self._migrate_state(data)
            current_day = datetime.datetime.utcnow().strftime("%Y-%m-%d")
            if data.get("last_reset_day") != current_day:
                data["daily_pnl"] = "0.0"
                data["last_reset_day"] = current_day
                data["consecutive_losses"] = 0

            data.setdefault("symbol_cooldowns", {})
            data.setdefault("schema_version", self._schema_version)
            return data

    def save(self, state: dict[str, Any]) -> None:
        with self._lock:
            state["schema_version"] = self._schema_version
            state["last_saved"] = datetime.datetime.utcnow().isoformat()
            try:
                self.state_file.parent.mkdir(parents=True, exist_ok=True)
                tmp = self.state_file.with_suffix(f".tmp.{os.getpid()}")
                with open(tmp, "w", encoding="utf-8") as fp:
                    json.dump(state, fp, indent=2, cls=ToolJSONEncoder, sort_keys=True)
                tmp.replace(self.state_file)
            except Exception as e:
                logging.error(f"Failed to persist scalper state: {e}")
                raise

    def log_trade(self, entry: dict[str, Any]) -> None:
        with self._lock:
            try:
                self.ledger_file.parent.mkdir(parents=True, exist_ok=True)
                self._rotate_ledger_if_needed()
                with open(self.ledger_file, "a", encoding="utf-8") as fp:
                    fp.write(json.dumps(entry, cls=ToolJSONEncoder, ensure_ascii=False) + "\n")
            except Exception as e:
                logging.error(f"Failed to append to trade ledger: {e}")
                raise

    def _default_state(self) -> dict[str, Any]:
        return {
            "schema_version": self._schema_version,
            "daily_pnl": "0.0",
            "consecutive_losses": 0,
            "equity_peak": "0.0",
            "wallet_equity": "2.00",
            "pause_until": None,
            "last_reset_day": datetime.datetime.utcnow().strftime("%Y-%m-%d"),
            "symbol_cooldowns": {},
            "created_at": datetime.datetime.utcnow().isoformat(),
        }

    def _migrate_state(self, data: dict[str, Any]) -> dict[str, Any]:
        version = data.get("schema_version", 1)
        if version >= self._schema_version:
            return data

        if version == 1:
            data.setdefault("equity_peak", data.get("wallet_equity", "0.0"))
            data.setdefault("created_at", datetime.datetime.utcnow().isoformat())
        data["schema_version"] = self._schema_version
        return data

    def _rotate_ledger_if_needed(self) -> None:
        if not self.ledger_file.exists():
            return
        if self.ledger_file.stat().st_size < self._max_ledger_bytes:
            return

        for i in range(self._backup_count - 1, 0, -1):
            src = self.ledger_file.with_suffix(f".jsonl.{i}")
            dst = self.ledger_file.with_suffix(f".jsonl.{i + 1}")
            if src.exists():
                src.replace(dst)

        self.ledger_file.replace(self.ledger_file.with_suffix(".jsonl.1"))

    def get_ledger_stats(self) -> dict[str, Any]:
        with self._lock:
            if not self.ledger_file.exists():
                return {"size_bytes": 0, "lines": 0, "backups": 0}
            stats = self.ledger_file.stat()
            lines = 0
            try:
                with open(self.ledger_file, "r", encoding="utf-8") as fp:
                    for _ in fp:
                        lines += 1
            except Exception:
                pass
            backups = sum(1 for p in self.ledger_file.parent.glob(f"{self.ledger_file.stem}.jsonl.*"))
            return {"size_bytes": stats.st_size, "lines": lines, "backups": backups}

    def reset_daily_state(self, state: dict[str, Any]) -> dict[str, Any]:
        with self._lock:
            state["daily_pnl"] = "0.0"
            state["consecutive_losses"] = 0
            state["last_reset_day"] = datetime.datetime.utcnow().strftime("%Y-%m-%d")
            return state

    def apply_cooldown(self, state: dict[str, Any], symbol: str, seconds: int) -> dict[str, Any]:
        with self._lock:
            until = datetime.datetime.utcnow() + datetime.timedelta(seconds=seconds)
            state.setdefault("symbol_cooldowns", {})[symbol] = until.isoformat()
            return state

    def is_cooled_down(self, state: dict[str, Any], symbol: str) -> bool:
        with self._lock:
            cooldowns = state.get("symbol_cooldowns", {})
            if symbol not in cooldowns:
                return True
            try:
                until = datetime.datetime.fromisoformat(cooldowns[symbol])
                return datetime.datetime.utcnow() >= until
            except Exception:
                return True
import signal
import threading
import contextlib
from typing import Any, Optional

class GracefulShutdown:
    def __init__(self) -> None:
        self._event = threading.Event()
        self._old_handlers: dict[int, Any] = {}
        self._signals_to_handle = self._get_signals()

    @staticmethod
    def _get_signals() -> list[int]:
        sigs = [signal.SIGINT, signal.SIGTERM]
        if hasattr(signal, "SIGBREAK"):
            sigs.append(signal.SIGBREAK)
        return sigs

    def __enter__(self) -> "GracefulShutdown":
        if threading.current_thread() is threading.main_thread():
            for sig in self._signals_to_handle:
                try:
                    self._old_handlers[sig] = signal.signal(sig, self._handle)
                except (ValueError, AttributeError, OSError):
                    pass
        return self

    def __exit__(
        self,
        exc_type: Optional[type[BaseException]],
        exc_val: Optional[BaseException],
        exc_tb: Any,
    ) -> None:
        if threading.current_thread() is threading.main_thread():
            for sig, old_handler in self._old_handlers.items():
                with contextlib.suppress(ValueError, AttributeError, OSError):
                    signal.signal(sig, old_handler)
            self._old_handlers.clear()

    def _handle(self, signum: int, frame: Any) -> None:
        self._event.set()

    def should_stop(self) -> bool:
        return self._event.is_set()

    def wait(self, timeout: Optional[float] = None) -> bool:
        return self._event.wait(timeout)

    def reset(self) -> None:
        self._event.clear()
from typing import Any


def generate_tool_schema() -> dict[str, Any]:
    return {
        "name": "micro_scalper_tool",
        "description": "High-frequency Bybit quantitative scalper evaluating OFI, depth ratios, dynamic spread-bands, and maker rebates. Supports single-symbol forced side or multi-symbol autonomous scan.",
        "strict": False,
        "parameters": {
            "type": "object",
            "properties": {
                "symbols": {"type": "string", "description": "Comma-separated list of symbols for multi-mode."},
                "symbol": {"type": "string", "description": "Single symbol (overrides symbols list)."},
                "side": {"type": "string", "enum": ["Buy", "Sell"], "description": "Forced side for single-symbol mode."},
                "target": {"type": ["string", "number", "null"], "description": "Target net profit USDT (default: 0.02)."},
                "target_profit": {"type": ["string", "number", "null"], "description": "Alias for target."},
                "leverage": {"type": ["integer", "number", "string", "null"], "description": "Leverage multiplier."},
                "pos_value": {"type": ["string", "number", "null"], "description": "Fixed notional cap."},
                "pos_pct": {"type": ["number", "string", "null"], "description": "Position equity percentage sizing."},
                "spread_max_bps": {"type": ["number", "string", "null"], "description": "Max spread in bps."},
                "max_positions": {"type": ["integer", "number", "string", "null"], "description": "Max simultaneous positions."},
                "cooldown": {"type": ["integer", "number", "string", "null"], "description": "Per-symbol trade cooldown in seconds."},
                "max_loss_trade": {"type": ["number", "string", "null"], "description": "Hard SL per trade USDT."},
                "daily_loss_cap": {"type": ["number", "string", "null"], "description": "Daily loss halt threshold."},
                "trailing_stop": {"type": ["string", "number", "null"], "description": "Trailing stop distance or null."},
                "loop": {"type": ["boolean", "string", "null"], "description": "Continuous mode."},
                "dry_run": {"type": ["boolean", "string", "null"], "description": "Simulation only."},
                "enable_ai": {"type": ["boolean", "string", "null"], "description": "Enable Ollama AI trade analysis."},
            },
            "additionalProperties": True,
        },
    }


# ==============================================================================
# SECTION 8: Ollama AI Reasoning Engine
# ==============================================================================
class OllamaReasoningEngine:
    @staticmethod
    def generate_trade_thesis(
        symbol: str,
        side: str,
        ofi: Decimal,
        momentum: Decimal,
        composite: Decimal,
        spread_bps: Decimal,
        host: str = "http://localhost:11434",
        model: str = "nemotron-3-nano:30b-cloud",
    ) -> Optional[str]:
        """Generate AI trade rationale via Ollama endpoint with tight timeout."""
        try:
            url = f"{host.rstrip('/')}/api/generate"
            prompt = (
                f"Analyze this high-frequency scalp trade setup in 1 concise sentence: "
                f"Symbol={symbol}, Direction={side}, OFI_Decay={float(ofi):.3f}, "
                f"DepthComposite={float(composite):.3f}, Momentum1m={float(momentum):+.3f}%, SpreadBps={float(spread_bps):.1f}."
            )
            payload = {
                "model": model,
                "prompt": prompt,
                "stream": False,
                "options": {
                    "temperature": 0.88,
                    "num_predict": 110,
                    "top_p": 0.9,
                },
            }
            req = urllib.request.Request(
                url,
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json"},
                method="POST",
            )
            with urllib.request.urlopen(req, timeout=4.0) as resp:
                if resp.status == 200:
                    data = json.loads(resp.read().decode("utf-8"))
                    return data.get("response", "").strip()
        except Exception:
            pass
        return None


