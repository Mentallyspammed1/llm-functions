# ── Bybit credentials ──────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Create API keys at https://www.bybit.com/app/user/api-management
# Grant ONLY: Contract Trading (read-write). Never enable withdrawal.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Network ────────────────────────────────────────────────────────────────
# true routes signed calls to api-testnet.bybit.com. Start here.
BYBIT_USE_TESTNET=true

# Skip the startup server-time sync (useful offline / in tests).
BYBIT_SYNC_TIME=false

# ── Proxy / Tor (optional) ─────────────────────────────────────────────────
PROXY_ENABLED=false
PROXY_TYPE=socks5h
PROXY_HOST=127.0.0.1
PROXY_PORT=9050

# ── Risk / runtime ─────────────────────────────────────────────────────────
REQUEST_TIMEOUT=15
MAX_RETRIES=3
# Journal + trade DB live at the repo root by default.
JOURNAL_PATH=bybit_journal.json
DB_PATH=bybit_trades.db
